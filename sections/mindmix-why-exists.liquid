  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .mm-why-fog, .mm-why-vow__caret { animation: none !important; }
    .mm-why--js [data-mm-reveal] { opacity: 1 !important; filter: none !important; transition: none !important; }
    .mm-why--js [data-mm-reveal]:not(.mm-why-pile__card) { transform: none !important; }
    .mm-why-pile__card { transition: none; }
    .mm-why-rail__seg { --mm-why-off: 0px !important; transition: none; }
    .mm-why-rail__fill { transform: scaleY(1) !important; transition: background-color 0.3s ease; }
    .mm-why-rail__gap { opacity: 1; transition: background-color 0.3s ease; }
    .mm-why-cal__from::after { transform: scaleX(1) !important; transition: none; }
    .mm-why-cutout { transform: none !important; transition: none; }
    .mm-why-aurora { transform: none !important; }
    .mm-why, .mm-why-sticky, .mm-why-light, .mm-why-btn { transition: none !important; }
    .mm-why-popup::before, .mm-why-popup__card { transition: none !important; transform: none !important; opacity: 1 !important; }
    .mm-why-hide-grid__pin { position: static !important; }
  }

  @media screen and (max-width: 639px) {
    .mm-why-mv { padding-left: 1.25rem; padding-right: 1.25rem; }
    .mm-why-col { padding-left: 14px; }
    .mm-why-cta-row .mm-why-btn { width: 100%; }
    .mm-why-cta-row { gap: 1.1rem; }
    .mm-why-sticky__brand { display: none; }
    .mm-why-sticky__inner { gap: 0.7rem; }
    .mm-why-sticky__cta { flex: 1 1 auto; }
    .mm-why-vow { min-height: 12rem; opacity: 0.95; }
    .mm-why-pile { min-height: 26rem; }
  }

  /* ------ v2 additions: hero cue, breaks, ingredient cards, pack picker ------ */
  .mm-why-scrollcue { display: flex; align-items: center; gap: 0.9rem; margin-top: 2.6rem; }
  .mm-why-scrollcue__label { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mm-why-muted); }
  .mm-why-scrollcue__arrow { width: 1px; height: 44px; background: linear-gradient(180deg, var(--mm-why-accent), transparent); position: relative; }
  .mm-why-scrollcue__arrow::after { content: ''; position: absolute; left: 50%; top: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--mm-why-accent); transform: translateX(-50%); animation: mm-why-cuedrop 2.2s ease-in-out infinite; box-shadow: 0 0 8px var(--mm-why-accent-soft); }
  @keyframes mm-why-cuedrop { 0% { top: 0; opacity: 0; } 25% { opacity: 1; } 78% { top: 38px; opacity: 1; } 100% { top: 44px; opacity: 0; } }
  .mm-why-mv--break { padding-top: clamp(1rem, 4vh, 2.5rem) !important; padding-bottom: clamp(1rem, 4vh, 2.5rem) !important; }
  .mm-why-break { margin: 0 auto; max-width: min(30rem, 86vw); }
  .mm-why-break img { width: 100%; height: auto; border-radius: 20px; border: 1px solid var(--mm-why-border); box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.85); display: block; }
  .mm-why-break--tight { max-width: 100%; }
  .mm-why-formula { display: grid; grid-template-columns: 1fr; gap: 0.9rem; margin: 2.2rem 0; }
  .mm-why-ing { position: relative; border: 1px solid var(--mm-why-border); border-radius: 18px; padding: 1.4rem 1.5rem 1.3rem; background: linear-gradient(180deg, var(--mm-why-accent-faint) 0%, rgba(0,0,0,0) 70%); overflow: hidden; }
  .mm-why-ing::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 3px; background: linear-gradient(180deg, var(--mm-why-accent), rgba(0,0,0,0)); opacity: 0.7; }
  .mm-why-ing .mm-why-ing__dose { font-size: 2rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1; }
  .mm-why-ing .mm-why-ing__name { margin-bottom: 0.2rem; }
  .mm-why-ing .mm-why-ing__for { display: inline-block; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mm-why-accent); border: 1px solid var(--mm-why-accent-soft); border-radius: 999px; padding: 0.25rem 0.7rem; margin: 0.5rem 0 0.7rem; }
  .mm-why-ing > p:last-child { margin-bottom: 0; color: var(--mm-why-muted); }
  @media (min-width: 760px) {
    .mm-why-formula { grid-template-columns: repeat(2, 1fr); }
    .mm-why-formula .mm-why-ing:first-child { grid-column: 1 / -1; }
  }
  .mm-why-offer__identity { color: var(--mm-why-muted); font-size: 1rem; margin: 0.4rem 0 1.4rem; }
  .mm-why-packs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; margin: 0.4rem 0 1rem; }
  .mm-why-pack { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.15rem; padding: 1.2rem 0.6rem 1rem; border: 1px solid var(--mm-why-border); border-radius: 16px; cursor: pointer; transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease; text-align: center; }
  .mm-why-pack input { position: absolute; opacity: 0; pointer-events: none; }
  .mm-why-pack.is-active { border-color: var(--mm-why-accent); background: var(--mm-why-accent-faint); transform: translateY(-2px); box-shadow: 0 10px 30px -14px var(--mm-why-accent-soft); }
  .mm-why-pack__flag { position: absolute; top: -0.62rem; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mm-why-bg); background: var(--mm-why-accent); border-radius: 999px; padding: 0.22rem 0.6rem; }
  .mm-why-pack__flag--gold { background: #d9a441; }
  .mm-why-pack__qty { font-family: var(--mm-why-font-h); font-size: 1.9rem; font-weight: 800; line-height: 1; color: var(--mm-why-text); }
  .mm-why-pack__unit { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mm-why-muted); }
  .mm-why-pack__price { font-weight: 700; color: var(--mm-why-text); margin-top: 0.45rem; font-variant-numeric: tabular-nums; }
  .mm-why-pack__per { font-size: 0.72rem; color: var(--mm-why-muted); }
  .mm-why-pack__soldout { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mm-why-muted); }
  .mm-why-offer__trust { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; justify-content: center; margin-top: 1.1rem; }
  .mm-why-offer__trust span { font-size: 0.75rem; color: var(--mm-why-muted); letter-spacing: 0.04em; display: inline-flex; align-items: center; gap: 0.4rem; }
  .mm-why-offer__trust span::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--mm-why-accent); }
  @media (max-width: 520px) {
    .mm-why-packs { grid-template-columns: 1fr; gap: 0.9rem; }
    .mm-why-pack { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: baseline; padding: 0.9rem 1.1rem; text-align: left; }
    .mm-why-pack__qty { font-size: 1.4rem; }
    .mm-why-pack__price { margin-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-why-scrollcue__arrow::after { animation: none; }
  }

</style>

<div id="why-mindmix-exists" class="mm-why" data-mm-why data-mm-sid="{{ section.id }}" data-mm-active-mood="void">

  <!-- Atmosphere -->
  <div class="mm-why-atmos" aria-hidden="true">
    <div class="mm-why-atmos__stick">
      {%- if s.image_texture != blank -%}
        <div class="mm-why-texture">
          {{ s.image_texture | image_url: width: 1800 | image_tag: widths: '900, 1400, 1800', sizes: '100vw', loading: 'lazy', alt: '' }}
        </div>
      {%- endif -%}
      <div class="mm-why-fog mm-why-fog--a"></div>
      <div class="mm-why-fog mm-why-fog--b"></div>
      <div class="mm-why-fog mm-why-fog--c"></div>
      <div class="mm-why-aurora"></div>
      {%- if s.enable_grain -%}<div class="mm-why-grain"></div>{%- endif -%}
    </div>
  </div>

  <!-- Promise line -->
  <div class="mm-why-rail" aria-hidden="true">
    <div class="mm-why-rail__stick" data-mm-rail>
      <div class="mm-why-rail__glow"></div>
      {%- for i in (1..13) -%}
        <div class="mm-why-rail__seg" data-mm-seg style="--mm-rd: {{ forloop.index0 | times: 70 }}ms">
          <div class="mm-why-rail__fill"></div>
          {%- unless forloop.last -%}<div class="mm-why-rail__gap"></div>{%- endunless -%}
        </div>
      {%- endfor -%}
      <div class="mm-why-rail__end"></div>
    </div>
  </div>

  <!-- Hero: controlled and unresolved -->
  <section class="mm-why-mv mm-why-beat" data-mm-mv data-mm-mood="void" id="mm-why-hero-{{ section.id }}">
    <div class="mm-why-col mm-why-hero-solo">
      <span class="mm-why-kicker mm-why-kicker--accent" data-mm-reveal>Why MindMix Exists</span>
      <h1 class="mm-why-h1" data-mm-reveal="strike" style="--mm-d:.2s">Why is the work that could change your life always the easiest to postpone?</h1>
      <div data-mm-reveal style="--mm-d:.45s">
        <p>When the deadline belongs to someone else, you deliver.</p>
        <p>When it belongs to your future, you find a reason to start tomorrow.</p>
      </div>
      <div class="mm-why-scrollcue" data-mm-reveal style="--mm-d:.7s" aria-hidden="true">
        <span class="mm-why-scrollcue__label">The answer costs nothing to read</span>
        <span class="mm-why-scrollcue__arrow"></span>
      </div>
    </div>
  </section>

  <!-- 1 · The deal with tomorrow: slipping and shifting -->
  <section class="mm-why-mv" data-mm-mv data-mm-mood="wound" id="mm-why-story-{{ section.id }}" tabindex="-1">
    <div class="mm-why-col">
      <h2 class="mm-why-h2" data-mm-reveal="strike">You had time today.</h2>
      <div class="mm-why-stack" data-mm-reveal data-mm-stagger>
        <p>Maybe not the whole day.</p>
        <p>But enough.</p>
      </div>
      <div class="mm-why-gap"></div>
      <div class="mm-why-stack" data-mm-stagger>
        <p data-mm-reveal>Enough to study for the test.</p>
        <p data-mm-reveal>Work on the business.</p>
        <p data-mm-reveal>Send the email you keep avoiding.</p>
        <p data-mm-reveal>Start.</p>
      </div>
      <div class="mm-why-gap"></div>
      <div data-mm-reveal>
        <p>Instead, you waited until beginning felt inconvenient.</p>
        <p>You checked the clock. Did the math on what you could still get done. Then made yourself a deal.</p>
      </div>
      <div class="mm-why-stack" data-mm-stagger>
        <p class="mm-why-beatline" data-mm-reveal>Tomorrow, you will wake up earlier.</p>
        <p class="mm-why-beatline" data-mm-reveal>Tomorrow, you will do it properly.</p>
        <p class="mm-why-beatline" data-mm-reveal>Tomorrow, you will finally lock in.</p>
      </div>
      <div data-mm-reveal>
        <p>The deal gives you just enough relief to stop feeling guilty tonight.</p>
        <p>And just enough hope to believe yourself again.</p>
      </div>
      <div data-mm-reveal="strike">
        <p class="mm-why-beatline">And somehow, the deal works.</p>
        <p class="mm-why-beatline">Not on the work.</p>
        <p class="mm-why-beatline">On the guilt.</p>
      </div>
      <p data-mm-reveal="strike">That is how another day disappears without ever feeling like you chose to waste it.</p>
    </div>
  </section>

  <!-- Visual break: the pour -->
  <section class="mm-why-mv mm-why-mv--break" data-mm-mv data-mm-mood="wound">
    <figure class="mm-why-break" data-mm-reveal="rise-long">
      <img src="https://cdn.shopify.com/s/files/1/0668/0117/2654/files/mm-why-break-pour.jpg?v=1784441882" alt="MindMix poured over ice" loading="lazy" width="900" height="1125">
    </figure>
  </section>

  <!-- 2 · Rescheduling and self-trust: fractured repetition -->
  <section class="mm-why-mv mm-why-mv--tight" data-mm-mv data-mm-mood="wound">
    <div class="mm-why-col">
      <h2 class="mm-why-h2" data-mm-reveal="strike">You do not quit.</h2>
      <p class="mm-why-h2sub" data-mm-reveal="strike" style="--mm-d:.3s">That would be too honest.</p>
      <p data-mm-reveal>You reschedule.</p>
      <div class="mm-why-cal" data-mm-stagger>
        <p class="mm-why-cal__row" data-mm-reveal><span class="mm-why-cal__from">Monday</span> becomes <span class="mm-why-cal__to">Tuesday</span>.</p>
        <p class="mm-why-cal__row" data-mm-reveal><span class="mm-why-cal__from">Tuesday</span> becomes <span class="mm-why-cal__to">&ldquo;sometime this week.&rdquo;</span></p>
      </div>
      <div data-mm-reveal>
        <p>You swear Sunday night was the final reset.</p>
        <p>By Monday afternoon, you are negotiating again.</p>
      </div>
      <div class="mm-why-gap"></div>
      <div data-mm-stagger>
        <p class="mm-why-ledgerline" data-mm-reveal>Every time you say &ldquo;tonight&rdquo; and mean &ldquo;not tonight,&rdquo; your word loses a little value.</p>
        <p class="mm-why-ledgerline" data-mm-reveal>Every fresh start begins with a little less belief than the one before it.</p>
      </div>
      <p class="mm-why-beatline" data-mm-reveal="strike">That is how self-trust disappears.</p>
    </div>
  </section>

  <!-- 3 · Productive-looking avoidance: visual accumulation -->
  <section class="mm-why-mv" data-mm-mv data-mm-mood="wound">
    <div class="mm-why-hide-grid">
      <div class="mm-why-hide-grid__pin">
        <h2 class="mm-why-h2" data-mm-reveal="strike">The hardest avoidance to catch looks productive.</h2>
        <div data-mm-reveal>
          <p>You are not sitting around doing nothing.</p>
          <p>That would be easy to catch.</p>
        </div>
        <div data-mm-reveal="strike">
          <p>Sometimes preparation is not preparation.</p>
          <p>Sometimes it is a hiding place.</p>
        </div>
      </div>
      <div class="mm-why-hide-grid__flow">
        <div class="mm-why-pile" data-mm-pile>
          <div class="mm-why-pile__stack">
            <p class="mm-why-pile__card" data-mm-reveal>Researching</p>
            <p class="mm-why-pile__card" data-mm-reveal>Planning</p>
            <p class="mm-why-pile__card" data-mm-reveal>Refining</p>
            <p class="mm-why-pile__card" data-mm-reveal>Comparing tools</p>
            <p class="mm-why-pile__card" data-mm-reveal>Cleaning the workspace</p>
            <p class="mm-why-pile__card" data-mm-reveal>Rebuilding the strategy</p>
          </div>
          <div class="mm-why-pile__base">
            <span class="mm-why-pile__base-label">The actual work</span>
            <span class="mm-why-pile__status">Not started</span>
          </div>
        </div>
        <div class="mm-why-gap"></div>
        <div class="mm-why-stack" data-mm-stagger data-mm-pile-clear>
          <p data-mm-reveal>As long as the business stays in your head, it can still become enormous.</p>
          <p data-mm-reveal>As long as you are still &ldquo;figuring it out,&rdquo; your potential remains safely untested.</p>
        </div>
        <div class="mm-why-gap"></div>
        <div data-mm-reveal="strike">
          <p>You are not always avoiding the work.</p>
          <p>Sometimes you are avoiding the evidence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Condensed identity turn: wide cinematic frame -->
  <section class="mm-why-mv mm-why-beat" data-mm-mv data-mm-mood="warm">
    <div class="mm-why-col mm-why-col--cine">
      <div class="mm-why-stack" data-mm-stagger>
        <p data-mm-reveal>People call you smart.</p>
        <p data-mm-reveal>Ambitious.</p>
        <p data-mm-reveal>Creative.</p>
        <p data-mm-reveal>Capable of doing something big.</p>
      </div>
      <div class="mm-why-gap"></div>
      <div data-mm-reveal>
        <p>Then the compliment follows you home and becomes an accusation.</p>
        <p>You can show up when someone else is counting on you.</p>
      </div>
      <p class="mm-why-beatline" data-mm-reveal="strike">Just apparently not for yourself.</p>
      <div data-mm-reveal>
        <p>If you did not care, none of this would hurt.</p>
        <p>You care.</p>
      </div>
      <p class="mm-why-h2sub" style="max-width: none; margin-left: auto; margin-right: auto;" data-mm-reveal="strike">That is why this hurts.</p>
      <div data-mm-reveal="strike">
        <p>You do not need a bigger dream.</p>
        <p>You need a beginning small enough to survive your own negotiation.</p>
      </div>
    </div>
  </section>

  <!-- 6 · Founder confession: raw and human -->
  <section class="mm-why-mv" data-mm-mv data-mm-mood="warm" id="mm-why-founder-{{ section.id }}" tabindex="-1">
    <div class="mm-why-founder-grid">
      <div>
        <h2 class="mm-why-h2" data-mm-reveal="strike">I did not build MindMix because I had focus figured out.</h2>
        <div data-mm-reveal>
          <p>I built it because I knew this pattern.</p>
          <p>I knew how to look capable while privately losing control of my attention, routines, and priorities.</p>
          <p>I knew how to make plans that sounded convincing.</p>
          <p>I knew how to chase stimulation and call it progress.</p>
        </div>
        <div data-mm-reveal>
          <p>I could spend hours describing the company I wanted MindMix to become, then let days pass without doing one thing that made it more real.</p>
          <p>I knew how to keep functioning just well enough that nobody could see how disappointed I had become in myself.</p>
        </div>
        {%- if s.founder_scene != blank -%}
        <div class="mm-why-founder-scene" data-mm-reveal>
          {{ s.founder_scene }}
        </div>
        {%- endif -%}
        <div data-mm-reveal>
          <p>MindMix did not rebuild my life.</p>
          <p>Treatment, recovery, exercise, structure, honesty, better decisions, and people willing to hold me accountable did that work.</p>
          <p>But while I was rebuilding, I became obsessed with one question:</p>
        </div>
      </div>
      <div class="mm-why-founder-media" data-mm-reveal="rise-long">
        {%- if s.image_founder != blank -%}
          {{ s.image_founder | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 48vw, 92vw', loading: 'lazy', alt: s.image_founder.alt | default: 'The founder of MindMix' }}
        {%- else -%}
          <figure class="mm-why-break mm-why-break--tight">
            <img src="https://cdn.shopify.com/s/files/1/0668/0117/2654/files/mm-why-break-macro.jpg?v=1784441882" alt="A prepared glass of MindMix with green apple and kiwi" loading="lazy" width="900" height="1125">
          </figure>
        {%- endif -%}
        {%- if s.founder_caption != blank -%}
        <span class="mm-why-founder-caption">{{ s.founder_caption | escape }}</span>
        {%- endif -%}
      </div>
    </div>
    <div class="mm-why-col" style="margin-top: clamp(3rem, 8vh, 5rem);">
      <h3 class="mm-why-h2" data-mm-reveal="strike">How do you make the moment of beginning harder to negotiate with?</h3>
      <div class="mm-why-stack" data-mm-stagger>
        <p data-mm-reveal>Not the whole transformation.</p>
        <p data-mm-reveal>Not a perfect day.</p>
        <p data-mm-reveal>Just the moment where intention becomes something physical or disappears again.</p>
      </div>
      <p data-mm-reveal="strike">That question became MindMix.</p>
      {%- if s.founder_name != blank or s.founder_role != blank -%}
      <p class="mm-why-founder-meta" data-mm-reveal>
        {%- if s.founder_name != blank -%}<strong style="display:block;color:var(--mm-why-text);">{{ s.founder_name | escape }}</strong>{%- endif -%}
        {%- if s.founder_role != blank -%}{{ s.founder_role | escape }}{%- endif -%}
      </p>
      {%- endif -%}
    </div>
  </section>

  <!-- 7 · Product ritual reveal: tactile and physical -->
  <section class="mm-why-mv" data-mm-mv data-mm-mood="product" data-mm-sticky-zone id="mm-why-product-{{ section.id }}" tabindex="-1" data-mm-product-mv>
    <div class="mm-why-prod-grid">
      <div>
        <h2 class="mm-why-h2" data-mm-reveal="strike">So I built a line you can cross.</h2>
        <p data-mm-reveal>MindMix is a Green Apple Kiwi drink mix made for the moment you decide to begin.</p>
        <ol class="mm-why-ritual">
          <li data-mm-reveal>Choose one task.</li>
          <li data-mm-reveal>Tear one stick.</li>
          <li data-mm-reveal>Mix the drink.</li>
          <li data-mm-reveal>Put the phone away.</li>
        </ol>
        <p data-mm-reveal>Begin before your mind produces another reasonable explanation for waiting.</p>
        <div class="mm-why-gap"></div>
        <div data-mm-reveal>
          <p>Before the ritual, the promise is still abstract.</p>
          <p>Making the drink turns the decision into something physical.</p>
