  <!-- 10 · Commercial offer: bright, simple, decisive -->
  <section class="mm-why-mv" data-mm-mv data-mm-mood="clear" data-mm-sticky-zone id="mm-why-buy-{{ section.id }}">
    <div class="mm-why-col">
      <div class="mm-why-offer" id="mm-why-offer-{{ section.id }}" data-mm-reveal="calm">
        {%- if s.image_offer != blank -%}
        <div class="mm-why-offer__media">
          {{ s.image_offer | image_url: width: 1000 | image_tag: widths: '500, 750, 1000', sizes: '(min-width: 640px) 34rem, 92vw', loading: 'lazy', alt: s.image_offer.alt | default: 'MindMix Green Apple Kiwi, 15 single-serve sticks' }}
        </div>
        {%- endif -%}
        <div class="mm-why-offer__sticks" aria-hidden="true">
          {%- for i in (1..s.offer_stick_count) -%}<span></span>{%- endfor -%}
        </div>
        <p class="mm-why-offer__kicker">Green Apple Kiwi</p>
        <p class="mm-why-offer__title">Choose your supply.</p>
        <p class="mm-why-offer__identity">Every stick is one session. Every session is a vote for the person you are becoming.</p>
        {%- if s.product != blank -%}
          {%- liquid
            assign mm_base_variant = nil
            for v in s.product.variants
              if v.title contains '15'
                assign mm_base_variant = v
              endif
            endfor
            unless mm_base_variant
              assign mm_base_variant = s.product.variants | first
            endunless
            assign mm_base_size = mm_base_variant.title | split: ' ' | first | times: 1
            assign mm_base_per = mm_base_variant.price | divided_by: mm_base_size
          -%}
          {%- form 'product', s.product -%}
            <input type="hidden" name="id" value="{{ mm_base_variant.id }}" data-mm-variant-id>
            <div class="mm-why-packs" role="radiogroup" aria-label="Choose your supply">
              {%- for v in s.product.variants -%}
                {%- assign vsize = v.title | split: ' ' | first | times: 1 -%}
                {%- assign vper = v.price | divided_by: vsize -%}
                {%- assign vpct = vper | times: 100 | divided_by: mm_base_per -%}
                {%- assign vsave = 100 | minus: vpct -%}
                {%- assign vsubcount = v.selling_plan_allocations | size -%}
                <label class="mm-why-pack{% if v.id == mm_base_variant.id %} is-active{% endif %}">
                  <input type="radio" name="mm-pack" value="{{ v.id }}"
                    {% if v.id == mm_base_variant.id %}checked{% endif %}
                    {% unless v.available %}disabled{% endunless %}
                    data-mm-pack data-mm-vid="{{ v.id }}"
                    data-mm-price="{{ v.price | money }}"
                    data-mm-plans-target="mm-plans-{{ v.id }}"
                    data-mm-pack-size="{{ vsize }}">
                  {%- if vsize == 30 -%}
                    <span class="mm-why-pack__flag">Most popular</span>
                  {%- elsif vsize == 90 -%}
                    <span class="mm-why-pack__flag mm-why-pack__flag--gold">Best value</span>
                  {%- endif -%}
                  <span class="mm-why-pack__qty">{{ vsize }}</span>
                  <span class="mm-why-pack__unit">sessions</span>
                  <span class="mm-why-pack__price">{{ v.price | money }}</span>
                  <span class="mm-why-pack__per">{{ vper | money }} per session{% if vsave > 0 %} &middot; save {{ vsave }}%{% endif %}</span>
                  {%- unless v.available -%}<span class="mm-why-pack__soldout">Sold out</span>{%- endunless -%}
                </label>
              {%- endfor -%}
            </div>

            <p class="mm-why-offer__price">
              <span data-mm-price-current>{{ mm_base_variant.price | money }}</span>
              <s class="mm-why-offer__compare" data-mm-price-compare hidden></s>
            </p>

            {%- for v in s.product.variants -%}
              {%- assign vallocs = v.selling_plan_allocations -%}
              {%- if vallocs.size > 0 -%}
              <fieldset class="mm-why-offer__plans" data-mm-plans="mm-plans-{{ v.id }}" {% unless v.id == mm_base_variant.id %}hidden disabled{% endunless %}>
                <legend class="mm-why-vh">Purchase options</legend>
                {%- for a in vallocs -%}
                  {%- assign mm_save = v.price | minus: a.price | times: 100 | divided_by: v.price -%}
                  <label class="mm-why-offer__plan">
                    <input type="radio" name="selling_plan" value="{{ a.selling_plan.id }}"
                      data-mm-plan data-mm-plan-kind="subscription" data-mm-cta="{{ s.offer_cta_sub | escape }}"
                      data-mm-price="{{ a.price | money }}" data-mm-compare="{{ v.price | money }}">
                    <span>
                      <span class="mm-why-offer__plan-name">{%- if mm_save > 0 -%}Subscribe and save {{ mm_save }}%{%- else -%}Subscribe{%- endif -%}</span>
                      <span class="mm-why-offer__plan-terms">{{ a.price | money }} &middot; {{ a.selling_plan.name | escape }}<br>{{ s.offer_sub_note | escape }}</span>
                    </span>
                    {%- if mm_save > 0 -%}<span class="mm-why-offer__save">Save {{ mm_save }}%</span>{%- endif -%}
                  </label>
                {%- endfor -%}
                <label class="mm-why-offer__plan">
                  <input type="radio" name="selling_plan" value="" checked
                    data-mm-plan data-mm-plan-kind="one_time" data-mm-cta="{{ s.offer_cta_once | escape }}"
                    data-mm-price="{{ v.price | money }}" data-mm-compare="">
                  <span>
                    <span class="mm-why-offer__plan-name">One-time purchase</span>
                    <span class="mm-why-offer__plan-terms">{{ v.price | money }} &middot; {{ s.offer_once_note | escape }}</span>
                  </span>
                </label>
              </fieldset>
              {%- endif -%}
            {%- endfor -%}

            <button type="submit" class="mm-why-btn mm-why-btn--primary" data-mm-atc {% unless mm_base_variant.available %}disabled{% endunless %}>
              {%- if mm_base_variant.available -%}{{ s.offer_cta_once | escape }}{%- else -%}Sold out{%- endif -%}
            </button>
            <div class="mm-why-offer__trust">
              <span>30-day money-back guarantee</span>
              <span>Third-party tested, certificate above</span>
              <span>Full doses on every label</span>
            </div>
          {%- endform -%}
        {%- elsif mm_product_url != blank -%}
          <a class="mm-why-btn mm-why-btn--primary" href="{{ mm_product_url }}" data-mm-atc>{{ s.offer_cta_once | escape }}</a>
        {%- else -%}
          <p class="mm-why-offer__note">Select a product in the section settings to activate this offer.</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- 11 · Final close: aligned and resolved -->
  <section class="mm-why-mv mm-why-beat" data-mm-mv data-mm-mood="clear" id="mm-why-close-{{ section.id }}">
    <div class="mm-why-col">
      <div class="mm-why-echo" data-mm-close-echo hidden>
