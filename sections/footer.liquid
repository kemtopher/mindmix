{% comment %}
  MindMix footer (definitive, 2026-07)
  LinkedIn + YouTube buttons, @getmindmix social defaults, expanded legal text
  default, and hardcoded fallback links for columns with no configured blocks.
  Schema gotcha that cost a day: header content > 50 chars (and over-long labels)
  make themeFilesUpsert fail SILENTLY via URL body; use TEXT body to see errors.
  - Social links are SECTION settings; icon renders only when a URL is set
  - Bottom bar links the real published pages: Terms, Privacy Policy (canonical
    /policies route), FDA Disclaimer, Your Privacy Choices
  - Link blocks have a coming_soon checkbox: non-link label + "Soon" chip
  - Scoped CSS (style.css is compiled Tailwind)
{% endcomment %}

<footer class="mm-footer">
  <div class="container-custom">
    <div class="mm-footer__grid">
      <div class="mm-footer__brand">
        {% render 'logo' %}

        {%- if section.settings.footer_text != blank -%}
          <p class="mm-footer__tagline">{{ section.settings.footer_text }}</p>
        {%- endif -%}

        {%- assign has_social = false -%}
        {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_channel_url != blank or section.settings.linkedin_url != blank or section.settings.x_url != blank or section.settings.facebook_url != blank -%}
          {%- assign has_social = true -%}
        {%- endif -%}
        {%- if has_social -%}
          <div class="mm-footer__social">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" class="mm-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                {% render 'icon-instagram' %}
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <a href="{{ section.settings.tiktok_url }}" class="mm-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
                {% render 'icon-tiktok' %}
              </a>
            {%- endif -%}
            {%- if section.settings.youtube_channel_url != blank -%}
              <a href="{{ section.settings.youtube_channel_url }}" class="mm-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
                {% render 'icon-youtube' %}
              </a>
            {%- endif -%}
            {%- if section.settings.linkedin_url != blank -%}
              <a href="{{ section.settings.linkedin_url }}" class="mm-footer__social-link" aria-label="LinkedIn" target="_blank" rel="noopener">
                {% render 'icon-linkedin' %}
              </a>
            {%- endif -%}
            {%- if section.settings.x_url != blank -%}
              <a href="{{ section.settings.x_url }}" class="mm-footer__social-link" aria-label="X" target="_blank" rel="noopener">
                {% render 'icon-twitter' %}
              </a>
            {%- endif -%}
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" class="mm-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
                {% render 'icon-facebook' %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign col1_blocks = section.blocks | where: 'type', 'column_1_link' -%}
      {%- assign col2_blocks = section.blocks | where: 'type', 'column_2_link' -%}
      {%- assign col3_blocks = section.blocks | where: 'type', 'column_3_link' -%}

      <nav class="mm-footer__cols" aria-label="Footer">
        {%- if section.settings.column_1_heading != blank or col1_blocks.size > 0 -%}
          <div class="mm-footer__col">
            {%- if section.settings.column_1_heading != blank -%}
              <h5 class="mm-footer__heading">{{ section.settings.column_1_heading | escape }}</h5>
            {%- endif -%}
            <ul class="mm-footer__list" role="list">
                            {%- if col1_blocks.size == 0 -%}
                <li><a href="/products/green-apple-kiwi" class="mm-footer__link">Green Apple Kiwi</a></li>
                <li><span class="mm-footer__link mm-footer__link--soon">Guava Passion<span class="mm-footer__soon-chip">Soon</span></span></li>
                <li><span class="mm-footer__link mm-footer__link--soon">Blueberry Lemon Tea<span class="mm-footer__soon-chip">Soon</span></span></li>
              {%- endif -%}
              {%- for block in col1_blocks -%}
                {%- capture mm_link_html -%}{% render 'mm-footer-link', block: block %}{%- endcapture -%}
                {%- assign mm_link_html = mm_link_html | strip -%}
                {%- if mm_link_html != '' -%}<li>{{ mm_link_html }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.column_2_heading != blank or col2_blocks.size > 0 -%}
          <div class="mm-footer__col">
            {%- if section.settings.column_2_heading != blank -%}
              <h5 class="mm-footer__heading">{{ section.settings.column_2_heading | escape }}</h5>
            {%- endif -%}
            <ul class="mm-footer__list" role="list">
                            {%- if col2_blocks.size == 0 -%}
                <li><a href="/pages/faq" class="mm-footer__link">FAQ</a></li>
              {%- endif -%}
              {%- for block in col2_blocks -%}
                {%- capture mm_link_html -%}{% render 'mm-footer-link', block: block %}{%- endcapture -%}
                {%- assign mm_link_html = mm_link_html | strip -%}
                {%- if mm_link_html != '' -%}<li>{{ mm_link_html }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.column_3_heading != blank or col3_blocks.size > 0 -%}
          <div class="mm-footer__col">
            {%- if section.settings.column_3_heading != blank -%}
              <h5 class="mm-footer__heading">{{ section.settings.column_3_heading | escape }}</h5>
            {%- endif -%}
            <ul class="mm-footer__list" role="list">
                            {%- if col3_blocks.size == 0 -%}
                <li><a href="/pages/contact" class="mm-footer__link">Contact</a></li>
              {%- endif -%}
              {%- for block in col3_blocks -%}
                {%- capture mm_link_html -%}{% render 'mm-footer-link', block: block %}{%- endcapture -%}
                {%- assign mm_link_html = mm_link_html | strip -%}
                {%- if mm_link_html != '' -%}<li>{{ mm_link_html }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </nav>
    </div>

    <div class="mm-footer__bottom">
      <p class="mm-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
      <ul class="mm-footer__legal-links" role="list">
        <li><a href="/pages/terms-and-conditions">Terms &amp; Conditions</a></li>
        <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a href="/pages/fda-disclaimer">FDA Disclaimer</a></li>
        <li><a href="/pages/data-sharing-opt-out">Your Privacy Choices</a></li>
      </ul>
    </div>

    {%- if section.settings.legal_text != blank -%}
      <p class="mm-footer__fda">{{ section.settings.legal_text }}</p>
    {%- endif -%}
  </div>
</footer>

<style>
  .mm-footer {
    background: var(--color-darker, #181818);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 64px 0 40px;
  }
  .mm-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .mm-footer__brand svg,
  .mm-footer__brand img {
    max-width: 150px;
    height: auto;
  }
  .mm-footer__tagline {
    color: rgba(224, 224, 224, 0.75);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 26rem;
    margin: 16px 0 0;
  }
  .mm-footer__social {
    display: flex;
    gap: 8px;
    margin-top: 24px;
  }
  .mm-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(224, 224, 224, 0.8);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .mm-footer__social-link:hover {
    color: var(--color-primary, #00e5a0);
    border-color: rgba(0, 229, 160, 0.4);
  }
  .mm-footer__social-link svg {
    width: 18px;
    height: 18px;
  }
  .mm-footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 24px;
  }
  .mm-footer__heading {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .mm-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mm-footer__link {
    color: rgba(224, 224, 224, 0.85);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .mm-footer__link:hover { color: var(--color-primary, #00e5a0); }
  .mm-footer__link--soon {
    color: rgba(224, 224, 224, 0.45);
    cursor: default;
  }
  .mm-footer__soon-chip {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(0, 229, 160, 0.35);
    color: var(--color-primary, #00e5a0);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    vertical-align: middle;
  }
  .mm-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 48px;
    padding-top: 28px;
  }
  .mm-footer__copyright {
    color: rgba(224, 224, 224, 0.5);
    font-size: 0.8125rem;
    margin: 0;
  }
  .mm-footer__legal-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
  }
  .mm-footer__legal-links a {
    color: rgba(224, 224, 224, 0.5);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .mm-footer__legal-links a:hover { color: var(--color-primary, #00e5a0); }
  .mm-footer__fda {
    color: rgba(224, 224, 224, 0.38);
    font-size: 0.75rem;
    line-height: 1.6;
    text-align: center;
    max-width: 46rem;
    margin: 24px auto 0;
  }

  @media (min-width: 768px) {
    .mm-footer__grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
    .mm-footer__cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .mm-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "logo_variant",
      "label": "Logo color",
      "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" },
        { "value": "brand_color", "label": "Brand color" }
      ]
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer description",
      "default": "A daily nootropic drink mix. Full doses, printed on the label."
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Column 1 heading",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Column 2 heading",
      "default": "Learn"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Column 3 heading",
      "default": "Support"
    },
    {
      "type": "header",
      "content": "Social links (icon renders only when a URL is set)"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/getmindmix/"
    },
    {
      "type": "text",
      "id": "tiktok_url",
      "label": "TikTok URL",
      "default": "https://www.tiktok.com/@getmindmix"
    },
    {
      "type": "text",
      "id": "x_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "text",
      "id": "youtube_channel_url",
      "label": "YouTube channel URL (empty = hidden)"
    },
    {
      "type": "text",
      "id": "linkedin_url",
      "label": "LinkedIn URL",
      "default": "https://www.linkedin.com/company/getmindmix"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "textarea",
      "id": "legal_text",
      "label": "Footer legal description",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. MindMix is for adults 18 and older. The information on this site is for educational purposes only and is not medical advice. If you are pregnant, nursing, or taking medication, consult your physician before use."
    }
  ],
  "blocks": [
    {
      "type": "column_1_link",
      "name": "Column 1 link",
      "settings": [
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming soon (renders label + Soon chip, no link)", "default": false }
      ]
    },
    {
      "type": "column_2_link",
      "name": "Column 2 link",
      "settings": [
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming soon (renders label + Soon chip, no link)", "default": false }
      ]
    },
    {
      "type": "column_3_link",
      "name": "Column 3 link",
      "settings": [
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" },
        { "type": "checkbox", "id": "coming_soon", "label": "Coming soon (renders label + Soon chip, no link)", "default": false }
      ]
    }
  ],
  "max_blocks": 60,
  "presets": [
    { "name": "Custom footer", "category": "Footer" }
  ]
}
{% endschema %}
