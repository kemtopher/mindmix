{%- comment -%}
  MindMix: Why It Exists teaser (v3, thin band).
  Compact, mobile-first, fully clickable band linking to the Why MindMix Exists page.
  Self-contained: scoped CSS + vanilla JS.
{%- endcomment -%}

{%- liquid
  assign t = section.settings
  assign tease_url = t.link_url | default: '/pages/why-mindmix-exists'
-%}

{% style %}
  #mm-tease-{{ section.id }} {
    --mmt-bg: {{ t.color_bg }};
    --mmt-text: {{ t.color_text }};
    --mmt-muted: {{ t.color_muted }};
    --mmt-accent: {{ t.color_accent }};
    --mmt-border: {{ t.color_text | color_modify: 'alpha', 0.14 }};
    --mmt-hairline: {{ t.color_text | color_modify: 'alpha', 0.07 }};
    --mmt-hi: {{ t.color_accent | color_modify: 'alpha', 0.14 }};
    --mmt-glow: {{ t.color_deep | color_modify: 'alpha', 0.5 }};
    --mmt-accent-soft: {{ t.color_accent | color_modify: 'alpha', 0.4 }};
  }
{% endstyle %}

<style>
  .mm-tease { position: relative; overflow: clip;
    background: linear-gradient(180deg, rgba(9, 11, 10, 0) 0%, var(--mmt-bg) 22%, var(--mmt-bg) 78%, rgba(9, 11, 10, 0) 100%); }
  .mm-tease *, .mm-tease *::before, .mm-tease *::after { box-sizing: border-box; }
  .mm-tease__atmos { position: absolute; inset: 0; pointer-events: none; }
  .mm-tease__fog { position: absolute; border-radius: 50%; }
  .mm-tease__fog--a { width: 60vmax; height: 60vmax; left: -20vmax; top: -25vmax; opacity: 0.5;
    background: radial-gradient(circle at 50% 50%, var(--mmt-glow), transparent 62%); }
  .mm-tease__fog--b { width: 45vmax; height: 45vmax; right: -15vmax; bottom: -20vmax; opacity: 0.55;
    background: radial-gradient(circle at 50% 50%, var(--mmt-hi), transparent 58%); }

  .mm-tease__wrap { position: relative; z-index: 1; display: block; text-decoration: none; color: inherit;
    padding: clamp(2.6rem, 6vh, 4rem) 1.25rem; }
  .mm-tease__wrap:focus-visible { outline: 2px solid var(--mmt-accent); outline-offset: -6px; }
  .mm-tease__inner { max-width: 64rem; margin: 0 auto; display: grid; gap: 1.8rem; align-items: center; }
  @media screen and (min-width: 820px) { .mm-tease__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 3.5rem; } }

  .mm-tease__eyebrow { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.64rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--mmt-accent); margin: 0 0 0.9rem; }
  .mm-tease__h {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 800; letter-spacing: -0.028em; line-height: 1.1; text-wrap: balance;
    font-size: clamp(1.45rem, 1.1rem + 2vw, 2.4rem); color: var(--mmt-text); margin: 0 0 1.1rem; }

  .mm-tease__line { display: flex; align-items: center; height: 2px; margin: 0 0 1.4rem; max-width: 19rem; }
  .mm-tease__line span { flex: 1 1 auto; height: 2px; border-radius: 2px; background: var(--mmt-border);
    margin-right: 12px; transition: margin 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), background-color 0.6s ease, transform 0.6s ease; }
  .mm-tease__line span:nth-child(odd) { transform: translateY(-2px); }
  .mm-tease__line span:last-child { margin-right: 0; }
  .mm-tease__wrap:hover .mm-tease__line span,
  .mm-tease__wrap:focus-visible .mm-tease__line span { margin-right: 0; transform: translateY(0); background: var(--mmt-accent); }

  .mm-tease__ctarow { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; }
  .mm-tease__cta { display: inline-flex; align-items: center; gap: 0.55rem; min-height: 44px;
    padding: 0.8rem 1.6rem; border-radius: 999px; font-weight: 600; font-size: 0.95rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: var(--mmt-accent); color: var(--mmt-bg);
    box-shadow: 0 0 0 1px var(--mmt-accent-soft), 0 8px 24px -14px var(--mmt-accent-soft);
    transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .mm-tease__cta svg { transition: transform 0.25s ease; }
  .mm-tease__wrap:hover .mm-tease__cta { transform: translateY(-2px);
    box-shadow: 0 0 0 1px var(--mmt-accent-soft), 0 12px 30px -12px var(--mmt-accent-soft); }
  .mm-tease__wrap:hover .mm-tease__cta svg { transform: translateX(3px); }
  .mm-tease__sub { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 0.82rem; color: var(--mmt-muted); margin: 0; }

  /* the self-rewriting promise, compact */
  .mm-tease__vow { position: relative; min-height: 7.5rem; display: flex; flex-direction: column; justify-content: flex-end;
    user-select: none;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, sans-serif; }
  @media screen and (min-width: 820px) { .mm-tease__vow { border-left: 1px solid var(--mmt-hairline); padding-left: 2.2rem; min-height: 9rem; } }
  .mm-tease__hist { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.8rem; }
  .mm-tease__ghost { font-weight: 600; font-size: clamp(0.88rem, 0.8rem + 0.5vw, 1.05rem); letter-spacing: -0.015em;
    color: var(--mmt-muted); text-decoration: line-through; text-decoration-thickness: 1.5px;
    transition: opacity 0.7s ease, transform 0.7s ease; transform: translateY(5px); }
  .mm-tease__ghost.is-in { transform: none; }
  .mm-tease__vowline { font-weight: 700; font-size: clamp(1.2rem, 1rem + 1.2vw, 1.7rem); line-height: 1.25;
    letter-spacing: -0.025em; color: var(--mmt-text); margin: 0; }
  .mm-tease__when { color: var(--mmt-accent); position: relative; white-space: nowrap;
    transition: opacity 0.3s ease, transform 0.3s ease; display: inline-block; }
  .mm-tease__when::after { content: ""; position: absolute; left: -2%; right: -2%; top: 54%; height: 2px;
    background: var(--mmt-muted); transform: scaleX(0); transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.6, 0, 0.2, 1); }
  .mm-tease__when.is-struck { color: var(--mmt-muted); }
  .mm-tease__when.is-struck::after { transform: scaleX(1); }
  .mm-tease__when.is-out { opacity: 0; transform: translateY(-6px); }
  .mm-tease__caret { display: inline-block; width: 2px; height: 0.95em; background: var(--mmt-accent);
    margin-left: 6px; vertical-align: -0.12em; animation: mmt-caret 1.1s steps(1) infinite; }
  @keyframes mmt-caret { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .mm-tease__caret { animation: none !important; }
    .mm-tease__line span { margin-right: 0 !important; transform: none !important; }
    .mm-tease__cta, .mm-tease__cta svg, .mm-tease__ghost, .mm-tease__when { transition: none !important; }
  }
  @media screen and (max-width: 639px) {
    .mm-tease__wrap { padding: 2.4rem 1.25rem; }
    .mm-tease__inner { gap: 1.4rem; }
    .mm-tease__cta { width: 100%; justify-content: center; }
    .mm-tease__ctarow { gap: 0.7rem; }
    .mm-tease__vow { min-height: 6.5rem; }
    .mm-tease__ghost:first-child { display: none; }
  }
</style>

<div class="mm-tease" id="mm-tease-{{ section.id }}" data-mm-tease>
  <div class="mm-tease__atmos" aria-hidden="true">
    <div class="mm-tease__fog mm-tease__fog--a"></div>
    <div class="mm-tease__fog mm-tease__fog--b"></div>
  </div>
  <a class="mm-tease__wrap" href="{{ tease_url }}">
    <div class="mm-tease__inner">
      <div>
        <p class="mm-tease__eyebrow">{{ t.eyebrow | escape }}</p>
        <h2 class="mm-tease__h">{{ t.heading | escape }}</h2>
        <div class="mm-tease__line" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="mm-tease__ctarow">
          <span class="mm-tease__cta">{{ t.cta_label | escape }}
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          {%- if t.cta_sub != blank -%}<p class="mm-tease__sub">{{ t.cta_sub | escape }}</p>{%- endif -%}
        </div>
      </div>
      <div class="mm-tease__vow" aria-hidden="true" data-mm-tease-vow>
        <div class="mm-tease__hist" data-mm-tease-hist></div>
        <p class="mm-tease__vowline"><span>I will start</span> <span class="mm-tease__when" data-mm-tease-when>tonight.</span><span class="mm-tease__caret"></span></p>
      </div>
    </div>
  </a>
</div>

<script>
  (function () {
    'use strict';
    function initTease(root) {
      if (!root || root.dataset.mmTeaseInit) return;
      root.dataset.mmTeaseInit = '1';
      var reduced = false;
      try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var vow = root.querySelector('[data-mm-tease-vow]');
      if (!vow || reduced) return;
      var whenEl = vow.querySelector('[data-mm-tease-when]');
      var hist = vow.querySelector('[data-mm-tease-hist]');
      var endings = ['tonight.', 'tomorrow.', 'on Monday.', 'next week.', 'when things calm down.'];
      var vi = 0;
      var active = false;
      var stopped = false;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) { active = entry.isIntersecting; });
        }, { threshold: 0.2 }).observe(vow);
      } else { active = true; }
      function refresh() {
        var gs = hist.querySelectorAll('.mm-tease__ghost');
        for (var i = 0; i < gs.length; i++) {
          gs[i].classList.add('is-in');
          gs[i].style.opacity = Math.max(0.14, 0.4 - (gs.length - 1 - i) * 0.14).toFixed(2);
        }
      }
      function step() {
        if (stopped) return;
        if (!active || document.hidden) { window.setTimeout(step, 1500); return; }
        whenEl.classList.add('is-struck');
        window.setTimeout(function () {
          if (stopped) return;
          var g = document.createElement('div');
          g.className = 'mm-tease__ghost';
          g.textContent = 'I will start ' + endings[vi];
          g.style.opacity = '0';
          hist.appendChild(g);
          while (hist.children.length > 2) hist.removeChild(hist.firstChild);
          requestAnimationFrame(function () { requestAnimationFrame(refresh); });
          vi = (vi + 1) % endings.length;
          if (vi === 0) hist.innerHTML = '';
          whenEl.classList.add('is-out');
          window.setTimeout(function () {
            whenEl.textContent = endings[vi];
            whenEl.classList.remove('is-struck');
            whenEl.classList.remove('is-out');
          }, 300);
          window.setTimeout(step, 2700);
        }, 1050);
      }
      window.setTimeout(step, 2000);
      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target && e.target.contains && e.target.contains(root)) stopped = true;
      });
    }
    function boot() { document.querySelectorAll('[data-mm-tease]').forEach(initTease); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('shopify:section:load', function (e) {
      var el = e.target && e.target.querySelector ? e.target.querySelector('[data-mm-tease]') : null;
      if (el) { delete el.dataset.mmTeaseInit; initTease(el); }
    });
  })();
</script>

{% schema %}
{
  "name": "MindMix Why Teaser",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before You Buy" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Why is the work that could change your life always the easiest to postpone?" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read Why It Exists" },
    { "type": "text", "id": "cta_sub", "label": "Line under the CTA", "default": "Read it before you buy anything." },
    { "type": "url", "id": "link_url", "label": "Destination", "info": "Defaults to /pages/why-mindmix-exists" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#090B0A" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#F3F0E8" },
    { "type": "color", "id": "color_muted", "label": "Muted", "default": "#A5ADA7" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#0CE4A0" },
    { "type": "color", "id": "color_deep", "label": "Deep green", "default": "#183D2A" }
  ],
  "presets": [
    { "name": "MindMix Why Teaser" }
  ]
}
{% endschema %}
