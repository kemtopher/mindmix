          </div>
          <p class="mm-why-form-status" data-mm-form-status role="status" aria-live="assertive"></p>
          <p class="mm-why-consent">{{ s.consent_text | escape }}</p>
        {%- endform -%}
      </div>

      <div aria-live="polite">
        <div class="mm-why-card" data-mm-promise-card hidden>
          <p class="mm-why-card__kicker">PROMISE RECORDED</p>
          <p class="mm-why-card__lead">You said you were going to:</p>
          <p class="mm-why-card__task" data-mm-promise-task></p>
          <p class="mm-why-card__time" data-mm-promise-time hidden></p>
          <p class="mm-why-card__note">Your first check-in arrives tomorrow.</p>
          <div class="mm-why-card__actions">
            <a class="mm-why-btn mm-why-btn--primary" href="{{ mm_buy_href }}" {% if mm_buy_scroll %}data-mm-scroll{% endif %}>Start With MindMix</a>
            <button type="button" class="mm-why-card__edit" data-mm-promise-edit>Edit</button>
          </div>
        </div>
      </div>
    </div>
  </section>


  {%- if s.disclaimer != blank -%}
  <hr class="mm-why-rule">
  <div class="mm-why-disclaimer">
    <div class="mm-why-col">{{ s.disclaimer }}</div>
  </div>
  {%- endif -%}

  <!-- Sticky CTA -->
  {%- if s.enable_sticky -%}
  <div class="mm-why-sticky" data-mm-sticky hidden>
    <div class="mm-why-sticky__inner">
      <span class="mm-why-sticky__brand">MindMix</span>
      <a class="mm-why-btn mm-why-btn--primary mm-why-sticky__cta" href="{{ mm_buy_href }}" {% if mm_buy_scroll %}data-mm-scroll{% endif %}>{{ s.cta_sticky | escape }}</a>
      <button type="button" class="mm-why-sticky__close" data-mm-sticky-close aria-label="Dismiss">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
  {%- endif -%}

  <!-- Reader acknowledgment popup -->
  {%- if s.enable_popup -%}
  <div class="mm-why-popup" data-mm-popup hidden role="dialog" aria-modal="true" aria-labelledby="mm-why-popup-title-{{ section.id }}">
    <div class="mm-why-popup__card">
      <button type="button" class="mm-why-popup__close" data-mm-popup-close aria-label="Close">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      {%- if s.popup_kicker != blank -%}<p class="mm-why-popup__kicker">{{ s.popup_kicker | escape }}</p>{%- endif -%}
      <p class="mm-why-popup__title" id="mm-why-popup-title-{{ section.id }}">{{ s.popup_heading | escape }}</p>
      <div class="mm-why-popup__body">{{ s.popup_body }}</div>
      {%- if s.popup_question != blank -%}<p class="mm-why-popup__question">{{ s.popup_question | escape }}</p>{%- endif -%}
      <div class="mm-why-popup__body">{{ s.popup_body2 }}</div>
      <div class="mm-why-popup__actions">
        <button type="button" class="mm-why-btn mm-why-btn--primary" data-mm-popup-write>{{ s.popup_primary | escape }}</button>
        <button type="button" class="mm-why-textlink mm-why-textlink--dim" style="background:none;border:0;cursor:pointer;font-family:inherit;min-height:44px;" data-mm-popup-close>{{ s.popup_button | escape }}</button>
      </div>
    </div>
  </div>
  {%- endif -%}

</div>

<script>
  (function () {
    'use strict';

    /* ============================================================
       DEVELOPER NOTE: promise form backend.
       Leave MM_PROMISE_ENDPOINT null to use the built-in Shopify
       customer capture (native POST: email + "first-promise" tag +
       truncated task tag). No credentials required.
       Set it to an approved HTTPS endpoint to switch to a JSON POST:
       { task, email, submittedAt } with inline success and error UI.
       ============================================================ */
    var MM_PROMISE_ENDPOINT = null;

    function initMmWhy(root) {
      if (!root || root.dataset.mmWhyInit) return;
      root.dataset.mmWhyInit = '1';
      root.classList.add('mm-why--js');

      var cleanup = [];
      root._mmWhyCleanup = cleanup;
      function on(target, ev, fn, opts) {
        target.addEventListener(ev, fn, opts);
        cleanup.push(function () { target.removeEventListener(ev, fn, opts); });
      }
      function every(ms, fn) {
        var id = window.setInterval(fn, ms);
        cleanup.push(function () { window.clearInterval(id); });
        return id;
      }

      var reduced = false;
      try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

      var LS_KEY = 'mm-why-first-promise';
      var LS_FLAG = 'mm-why-promise-committed';
      var LS_AT = 'mm-why-promise-at';
      var LS_POP = 'mm-why-popup-dismissed-at';
      var SS_KEY = 'mm-why-sticky-dismissed';
      function lsGet(k) { try { return window.localStorage.getItem(k) || ''; } catch (e) { return ''; } }
      function lsSet(k, v) { try { window.localStorage.setItem(k, v); } catch (e) {} }
      function ssGet() { try { return window.sessionStorage.getItem(SS_KEY) === '1'; } catch (e) { return false; } }
      function ssSet() { try { window.sessionStorage.setItem(SS_KEY, '1'); } catch (e) {} }

      function track(name, data) {
        try {
          if (window.dataLayer && window.dataLayer.push) {
            var payload = { event: 'mm_why_' + name };
            if (data) for (var k in data) payload[k] = data[k];
            window.dataLayer.push(payload);
          }
          document.dispatchEvent(new CustomEvent('mm-why:' + name, { detail: data || {} }));
        } catch (e) {}
      }

      /* ---------- Reveals ---------- */
      var reveals = root.querySelectorAll('[data-mm-reveal]');
      root.querySelectorAll('[data-mm-stagger]').forEach(function (group) {
        var kids = group.querySelectorAll('[data-mm-reveal]');
        kids.forEach(function (el, i) { el.style.setProperty('--mm-d', Math.min(i * 0.11, 0.9) + 's'); });
      });
      if (!reduced && 'IntersectionObserver' in window) {
        var revealIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              revealIO.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -7% 0px' });
        reveals.forEach(function (el) { revealIO.observe(el); });
      } else {
        reveals.forEach(function (el) { el.classList.add('is-in'); });
      }

      /* ---------- Mood + sticky visibility ---------- */
      var movements = root.querySelectorAll('[data-mm-mv]');
      var sticky = root.querySelector('[data-mm-sticky]');
      var stickyDismissed = ssGet();
      var stickyArmed = false;
      function setSticky(onState) {
        if (!sticky || stickyDismissed) return;
        if (onState && !stickyArmed) { stickyArmed = true; sticky.hidden = false; }
        requestAnimationFrame(function () { sticky.classList.toggle('is-on', onState && stickyArmed); });
      }
      if (sticky) {
        var closeBtn = sticky.querySelector('[data-mm-sticky-close]');
        if (closeBtn) closeBtn.addEventListener('click', function () {
          stickyDismissed = true; ssSet();
          sticky.classList.remove('is-on');
          window.setTimeout(function () { sticky.hidden = true; }, 500);
        });
      }
      if ('IntersectionObserver' in window) {
        var moodIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var mood = entry.target.getAttribute('data-mm-mood') || 'void';
            root.setAttribute('data-mm-active-mood', mood);
            setSticky(entry.target.hasAttribute('data-mm-sticky-zone'));
          });
        }, { rootMargin: '-42% 0px -42% 0px', threshold: 0 });
        movements.forEach(function (mv) { moodIO.observe(mv); });
      }

      /* ---------- Promise line + scroll progress + product rotation ---------- */
      var segs = root.querySelectorAll('[data-mm-seg]');
      var productMv = root.querySelector('[data-mm-product-mv]');
      var cutout = root.querySelector('.mm-why-cutout');
      var maxP = 0;
      var depthFired = {};
      var ticking = false;
      function paintFrame() {
        ticking = false;
        var rect = root.getBoundingClientRect();
        var total = rect.height - window.innerHeight;
        if (total <= 0) return;
        var p = Math.min(1, Math.max(0, -rect.top / total));
        if (p > maxP) maxP = p;
        [0.25, 0.5, 0.75, 0.98].forEach(function (m) {
          if (maxP >= m && !depthFired[m]) { depthFired[m] = true; track('scroll_depth', { depth: m }); }
        });
        root.style.setProperty('--mm-p', p.toFixed(4));
        if (!reduced) {
          var n = segs.length;
          for (var i = 0; i < n; i++) {
            var fill = Math.min(1, Math.max(0, p * n - i));
            segs[i].querySelector('.mm-why-rail__fill').style.setProperty('--mm-why-fill', fill.toFixed(3));
            segs[i].classList.toggle('is-filled', fill > 0.55);
            segs[i].classList.toggle('is-linked', p * n >= i + 1);
          }
          if (productMv && cutout) {
            var pr = productMv.getBoundingClientRect();
            var q = Math.min(1, Math.max(0, (window.innerHeight * 0.75 - pr.top) / pr.height));
            if (q >= 0.72) {
              root.classList.add('is-settled');
            } else {
              root.classList.remove('is-settled');
              cutout.style.setProperty('--mm-rot', (-6 + q * 8).toFixed(2) + 'deg');
              cutout.style.setProperty('--mm-par', ((1 - q) * 26).toFixed(1) + 'px');
            }
          }
        }
      }
      function requestFrame() { if (!ticking) { ticking = true; requestAnimationFrame(paintFrame); } }
      on(window, 'scroll', requestFrame, { passive: true });
      on(window, 'resize', requestFrame);
      paintFrame();

      /* ---------- Cursor lighting (desktop only, decorative) ---------- */
      var lightHosts = root.querySelectorAll('[data-mm-light]');
      var finePointer = false;
      try { finePointer = window.matchMedia('(pointer: fine)').matches; } catch (e) {}
      if (finePointer && !reduced) {
        lightHosts.forEach(function (host) {
          var raf = null;
          host.addEventListener('pointerenter', function () { host.classList.add('is-lit'); });
          host.addEventListener('pointerleave', function () { host.classList.remove('is-lit'); });
          host.addEventListener('pointermove', function (e) {
            if (raf) return;
            raf = requestAnimationFrame(function () {
              raf = null;
              var r = host.getBoundingClientRect();
              host.style.setProperty('--mm-lx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
              host.style.setProperty('--mm-ly', ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%');
            });
          });
        });
      }

      /* ---------- Smooth scroll ---------- */
      root.querySelectorAll('[data-mm-scroll]').forEach(function (link) {
        link.addEventListener('click', function (e) {
          var id = link.getAttribute('href');
          if (!id || id.charAt(0) !== '#') return;
          var target = document.getElementById(id.slice(1));
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
          target.focus({ preventScroll: true });
        });
      });

      /* ---------- The self-rewriting promise (hero) ---------- */
      var vow = root.querySelector('[data-mm-vow]');
      if (vow && !reduced) {
        var whenEl = vow.querySelector('[data-mm-vow-when]');
        var vowHist = vow.querySelector('[data-mm-vow-history]');
        var endings = ['tonight.', 'tomorrow.', 'on Monday.', 'next week.', 'when things calm down.'];
        var vi = 0;
        var vowActive = false;
        var vowStopped = false;
        cleanup.push(function () { vowStopped = true; });
        var ghostRefresh = function () {
          var gs = vowHist.querySelectorAll('.mm-why-vow__ghost');
          for (var i = 0; i < gs.length; i++) {
            gs[i].classList.add('is-in');
            gs[i].style.opacity = Math.max(0.12, 0.42 - (gs.length - 1 - i) * 0.14).toFixed(2);
          }
        };
        var vowStep = function () {
          if (vowStopped) return;
          if (!vowActive || document.hidden) { window.setTimeout(vowStep, 1500); return; }
          whenEl.classList.add('is-struck');
          window.setTimeout(function () {
            if (vowStopped) return;
            var g = document.createElement('div');
            g.className = 'mm-why-vow__ghost';
            g.textContent = 'I will start ' + endings[vi];
            g.style.opacity = '0';
            vowHist.appendChild(g);
            while (vowHist.children.length > 3) vowHist.removeChild(vowHist.firstChild);
            requestAnimationFrame(function () { requestAnimationFrame(ghostRefresh); });
            vi = (vi + 1) % endings.length;
            if (vi === 0) vowHist.innerHTML = '';
            whenEl.classList.add('is-out');
            window.setTimeout(function () {
              whenEl.textContent = endings[vi];
              whenEl.classList.remove('is-struck');
              whenEl.classList.remove('is-out');
            }, 300);
            window.setTimeout(vowStep, 2700);
          }, 1050);
        };
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) { vowActive = entry.isIntersecting; });
          }, { threshold: 0.2 }).observe(vow);
        } else { vowActive = true; }
        window.setTimeout(vowStep, 2300);
      }

      /* ---------- Avoidance pile: clear to reveal the untouched task ---------- */
      var pile = root.querySelector('[data-mm-pile]');
      var pileClear = root.querySelector('[data-mm-pile-clear]');
      if (pile && pileClear && 'IntersectionObserver' in window) {
        var pileIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { pile.classList.add('is-cleared'); pileIO.disconnect(); }
          });
        }, { threshold: 0.5 });
        pileIO.observe(pileClear);
      }

      /* ---------- The first promise: validated, stateful form ---------- */
      var promiseWrap = root.querySelector('[data-mm-promise-wrap]');
      var form = promiseWrap ? promiseWrap.querySelector('form') : null;
      var input = root.querySelector('[data-mm-promise-input]');
      var emailInput = root.querySelector('[data-mm-promise-email]');
      var tagsField = root.querySelector('[data-mm-promise-tags]');
      var submitBtn = root.querySelector('[data-mm-submit-btn]');
      var statusEl = root.querySelector('[data-mm-form-status]');
      var errTask = root.querySelector('[data-mm-err="task"]');
      var errEmail = root.querySelector('[data-mm-err="email"]');
      var card = root.querySelector('[data-mm-promise-card]');
      var taskEl = root.querySelector('[data-mm-promise-task]');
      var timeEl = root.querySelector('[data-mm-promise-time]');
      var editBtn = root.querySelector('[data-mm-promise-edit]');
      var finalCta = root.querySelector('[data-mm-final-cta]');
      var closeEcho = root.querySelector('[data-mm-close-echo]');
      var closeTask = root.querySelector('[data-mm-close-task]');
      var committed = false;
      var submitting = false;

      function shorten(t) {
        if (t.length <= 26) return t;
        var cut = t.slice(0, 24);
        var sp = cut.lastIndexOf(' ');
        if (sp > 12) cut = cut.slice(0, sp);
        return cut + '…';
      }
      function setStatus(msg, kind) {
        if (!statusEl) return;
        statusEl.textContent = msg || '';
        statusEl.classList.toggle('is-error', kind === 'error');
        statusEl.classList.toggle('is-ok', kind === 'ok');
      }
      function setFieldError(el, errEl, onState) {
        if (el) el.classList.toggle('is-invalid', onState);
        if (errEl) errEl.classList.toggle('is-on', onState);
      }
      function setLoading(onState) {
        submitting = onState;
        if (!submitBtn) return;
        if (onState) {
          submitBtn.setAttribute('data-mm-orig', submitBtn.textContent);
          submitBtn.textContent = 'Sending...';
          submitBtn.disabled = true;
        } else {
          submitBtn.textContent = submitBtn.getAttribute('data-mm-orig') || submitBtn.textContent;
          submitBtn.disabled = false;
        }
      }
      function applyPromise(task, moveFocus) {
        if (!card || !taskEl) return;
        taskEl.textContent = task;
        var at = lsGet(LS_AT);
        if (timeEl && at) {
          try {
            timeEl.textContent = 'Recorded ' + new Date(at).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
            timeEl.hidden = false;
          } catch (e) { timeEl.hidden = true; }
        }
        card.hidden = false;
        if (promiseWrap) promiseWrap.hidden = true;
        if (finalCta) finalCta.textContent = 'Start: ' + shorten(task);
        if (closeEcho && closeTask) { closeTask.textContent = task; closeEcho.hidden = false; }
        root.classList.add('is-committed');
        if (moveFocus && editBtn) editBtn.focus();
      }
      function backToEdit() {
        if (!promiseWrap || !input) return;
        promiseWrap.hidden = false;
        if (card) card.hidden = true;
        if (finalCta) finalCta.textContent = finalCta.getAttribute('data-mm-default-label') || finalCta.textContent;
        input.value = lsGet(LS_KEY);
        input.focus();
      }
      function validate() {
        var task = input ? input.value.replace(/\s+/g, ' ').trim() : '';
        var email = emailInput ? emailInput.value.trim() : '';
        var okTask = task.length > 0;
        var okEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        setFieldError(input, errTask, !okTask);
        setFieldError(emailInput, errEmail, !okEmail);
        if (!okTask) { setStatus('Write the thing you keep postponing first.', 'error'); input.focus(); return null; }
        if (!okEmail) { setStatus('Enter a valid email address.', 'error'); emailInput.focus(); return null; }
        setStatus('', '');
        return { task: task.slice(0, 140), email: email };
      }
      if (form && input && emailInput) {
        form.setAttribute('novalidate', 'novalidate');
        form.addEventListener('submit', function (e) {
          if (submitting) { e.preventDefault(); return; }
          var data = validate();
          if (!data) { e.preventDefault(); return; }
          lsSet(LS_KEY, data.task);
          lsSet(LS_AT, new Date().toISOString());
          if (tagsField) tagsField.value = 'first-promise,p:' + data.task.replace(/,/g, ' ').slice(0, 36).trim();
          track('commit_submit');
          if (MM_PROMISE_ENDPOINT) {
            e.preventDefault();
            setLoading(true);
            setStatus('Sending your promise...', '');
            fetch(MM_PROMISE_ENDPOINT, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ task: data.task, email: data.email, submittedAt: new Date().toISOString() })
            }).then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              lsSet(LS_FLAG, '1');
              setLoading(false);
              setStatus('Promise recorded.', 'ok');
              track('commit_success');
              applyPromise(data.task, true);
            }).catch(function () {
              setLoading(false);
              setStatus('Something went wrong sending your promise. Your words are saved on this device. Try again.', 'error');
            });
          } else {
            /* native Shopify POST: leave the page; loading state guards double taps */
            e.preventDefault();
            setLoading(true);
            setStatus('Sending your promise...', '');
            form.submit();
          }
        });
        input.addEventListener('input', function () { setFieldError(input, errTask, false); });
        emailInput.addEventListener('input', function () { setFieldError(emailInput, errEmail, false); });
        if (editBtn) editBtn.addEventListener('click', backToEdit);

        committed = /[?&](customer_posted=true|mm-committed=1)/.test(window.location.search) || lsGet(LS_FLAG) === '1';
        var saved = lsGet(LS_KEY);
        if (committed) {
          lsSet(LS_FLAG, '1');
          if (/[?&]mm-committed=1/.test(window.location.search)) track('commit_success');
          if (saved) applyPromise(saved, false);
          else root.classList.add('is-committed');
        } else if (saved) {
          input.value = saved;
        }

        if ('IntersectionObserver' in window && promiseWrap) {
          var seenFormIO = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) { track('commit_view'); seenFormIO.disconnect(); }
            });
          }, { threshold: 0.4 });
          seenFormIO.observe(promiseWrap);
        }
      }

      /* ---------- Offer: pack picker + purchase option switch ---------- */
      var priceCur = root.querySelector('[data-mm-price-current]');
      var priceCmp = root.querySelector('[data-mm-price-compare]');
      var atcBtn = root.querySelector('[data-mm-atc]');
      var vidInput = root.querySelector('[data-mm-variant-id]');
      function mmActivePlans() {
        var checked = root.querySelector('[data-mm-pack]:checked');
        if (!checked) return null;
        return root.querySelector('[data-mm-plans="' + checked.getAttribute('data-mm-plans-target') + '"]');
      }
      function mmSyncOffer(source) {
        var pack = root.querySelector('[data-mm-pack]:checked');
        if (!pack) return;
        if (vidInput) vidInput.value = pack.getAttribute('data-mm-vid');
        root.querySelectorAll('.mm-why-pack').forEach(function (card) {
          var input = card.querySelector('[data-mm-pack]');
          card.classList.toggle('is-active', !!(input && input.checked));
        });
        root.querySelectorAll('[data-mm-plans]').forEach(function (fs) {
          var active = fs.getAttribute('data-mm-plans') === pack.getAttribute('data-mm-plans-target');
          fs.hidden = !active;
          fs.disabled = !active;
        });
        var plans = mmActivePlans();
        var price = pack.getAttribute('data-mm-price');
        var cmp = '';
        var ctaLabel = null;
        if (plans) {
          var plan = plans.querySelector('[data-mm-plan]:checked') || plans.querySelector('[data-mm-plan]');
          if (plan) {
            price = plan.getAttribute('data-mm-price') || price;
            cmp = plan.getAttribute('data-mm-compare') || '';
            ctaLabel = plan.getAttribute('data-mm-cta');
          }
        }
        if (priceCur && price) priceCur.textContent = price;
        if (priceCmp) {
          if (cmp && cmp !== price) { priceCmp.textContent = cmp; priceCmp.hidden = false; }
          else { priceCmp.hidden = true; }
        }
        if (atcBtn && !atcBtn.disabled && ctaLabel) atcBtn.textContent = ctaLabel;
        if (source === 'pack') track('offer_pack_change', { pack: pack.getAttribute('data-mm-pack-size') });
        if (source === 'plan') {
          var pr = plans && plans.querySelector('[data-mm-plan]:checked');
          track('offer_plan_change', { plan: pr ? pr.getAttribute('data-mm-plan-kind') : 'one_time' });
        }
      }
      root.querySelectorAll('[data-mm-pack]').forEach(function (r) {
        r.addEventListener('change', function () { mmSyncOffer('pack'); });
      });
      root.querySelectorAll('[data-mm-plan]').forEach(function (r) {
        r.addEventListener('change', function () { mmSyncOffer('plan'); });
      });
      mmSyncOffer();
      root.querySelectorAll('[data-mm-product-cta]').forEach(function (el) {
        el.addEventListener('click', function () { track('product_cta_click'); });
      });
      root.querySelectorAll('[data-mm-atc]').forEach(function (el) {
        var host = el.closest('form');
        if (host) host.addEventListener('submit', function () { track('add_to_cart'); });
        else el.addEventListener('click', function () { track('add_to_cart'); });
      });
      var details = root.querySelector('.mm-why-details');
      if (details) details.addEventListener('toggle', function () { if (details.open) track('formula_open'); });

      /* ---------- Editorial interruption: engaged non-submitters only ---------- */
      var popup = root.querySelector('[data-mm-popup]');
      if (popup && !reduced) {
        var startedAt = Date.now();
        var popShown = false;
        var prevFocus = null;
        var dismissedAt = parseInt(lsGet(LS_POP), 10) || 0;
        var recentlyDismissed = dismissedAt && (Date.now() - dismissedAt) < 7 * 24 * 60 * 60 * 1000;
        var popupOpen = function () {
          popShown = true;
          popup.hidden = false;
          requestAnimationFrame(function () { popup.classList.add('is-on'); });
          prevFocus = document.activeElement;
          var c = popup.querySelector('[data-mm-popup-close]');
          if (c) c.focus();
          track('popup_shown');
        };
        var popupClose = function (silent) {
          popup.classList.remove('is-on');
          window.setTimeout(function () { popup.hidden = true; }, 350);
          lsSet(LS_POP, String(Date.now()));
          if (silent !== true) track('popup_dismissed');
