{% comment %}
  MindMix hero (upgraded 2026-07)
  - In-flow CTA row (the old absolutely-positioned try-it-free-btn rendered clipped
    off-screen on mobile and was the only CTA; removed)
  - Three text levels: eyebrow / H1 with highlight phrase / lede
  - "Label facts" row instead of icon benefit cards
  - Scoped CSS: style.css is compiled Tailwind, new utility classes will not exist
{% endcomment %}

{%- assign hl = section.settings.heading_highlight | strip -%}
{%- assign heading_html = section.settings.heading | escape -%}
{%- if hl != blank -%}
  {%- assign hl_esc = hl | escape -%}
  {%- capture hl_span -%}<span class="mm-hero__hl">{{ hl_esc }}</span>{%- endcapture -%}
  {%- assign heading_html = heading_html | replace: hl_esc, hl_span -%}
{%- endif -%}

<section class="mm-hero neural-bg" id="mm-hero">
  <div class="container-custom">
    <div class="mm-hero__grid">
      <div class="mm-hero__copy fade-in">
        {%- if section.settings.tagline != blank -%}
          <p class="mm-hero__eyebrow">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}

        <h1 class="mm-hero__h1">{{ heading_html }}</h1>

        {%- if section.settings.lede_text != blank -%}
          <p class="mm-hero__lede">{{ section.settings.lede_text | escape }}</p>
        {%- endif -%}

        {%- assign hero_desc = section.settings.hero_desc | default: "MindMix isn't a quick fix. It's a daily ritual that compounds. It's about optimizing your mind for the long game. In your first week, you'll feel the difference. By month one, you'll never go back." -%}
        {%- if hero_desc != blank -%}
          <p class="mm-hero__desc">{{ hero_desc | escape }}</p>
        {%- endif -%}

        {%- assign chip_1 = section.settings.chip_1 | default: 'Green Apple Kiwi, in stock now' -%}
        {%- assign chip_2 = section.settings.chip_2 | default: '2 new flavors coming soon' -%}
        {%- if chip_1 != blank or chip_2 != blank -%}
          <div class="mm-hero__chips">
            {%- if chip_1 != blank -%}<span class="mm-hero__chip mm-hero__chip--live">{{ chip_1 | escape }}</span>{%- endif -%}
            {%- if chip_2 != blank -%}<span class="mm-hero__chip">{{ chip_2 | escape }}</span>{%- endif -%}
          </div>
        {%- endif -%}

        <div class="mm-hero__ctas">
          <a class="mm-hero__cta mm-hero__cta--gradient" href="{{ section.settings.cta_url | default: '/products/green-apple-kiwi' }}">
            <span class="mm-hero__cta-label">{{ section.settings.cta_text | default: 'Get MindMix' | escape }}</span>
          </a>
          {%- assign sec_text = section.settings.secondary_cta_text | default: 'Watch the ritual' -%}
          {%- assign sec_url = section.settings.secondary_cta_url | default: '#shopify-section-mindmix-cinematic' -%}
          {%- if sec_text != blank and sec_url != blank -%}
            <a class="mm-hero__cta mm-hero__cta--ghost" href="{{ sec_url }}">
              {{ sec_text | escape }}
            </a>
          {%- endif -%}
        </div>
        {%- assign cta_note = section.settings.price_note | default: 'Get your MindMix today for as low as $69.95.' -%}
        {%- if cta_note != blank -%}
          <p class="mm-hero__cta-note">{{ cta_note | escape }}</p>
        {%- endif -%}
      </div>

      <div class="mm-hero__media fade-in">
        <div class="mm-hero__glow" aria-hidden="true"></div>
        {%- assign hero = section.settings.hero_image -%}
        {%- if hero != blank -%}
          <img
            class="mm-hero__img"
            alt="{{ hero.alt | default: 'MindMix nootropic drink mix' | escape }}"
            width="{{ hero.width }}"
            height="{{ hero.height }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            src="{{ hero | image_url: width: 900 }}"
            srcset="
              {{ hero | image_url: width: 480 }} 480w,
              {{ hero | image_url: width: 640 }} 640w,
              {{ hero | image_url: width: 900 }} 900w,
              {{ hero | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 1024px) 48vw, 92vw"
          >
        {%- else -%}
          <img
            class="mm-hero__img"
            alt="MindMix Green Apple Kiwi stick pack"
            loading="eager"
            decoding="async"
            src="{{ 'mindmix_green_apple_kiwi.png' | asset_url }}"
          >
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    Proof badges: bold two-line claims-safe receipts, sticker-tilted, floating and
    swaying to pull the eye. Setting format: "HEADLINE|supporting line" (pipe splits).
  {%- endcomment -%}
  {%- assign badge_1 = section.settings.badge_1 | default: 'FULL DOSES. ZERO HIDING.|Every dose printed on the label' -%}
  {%- assign badge_2 = section.settings.badge_2 | default: 'THIRD-PARTY TESTED|Certificate of analysis available' -%}
  {%- assign badge_3 = section.settings.badge_3 | default: '30-DAY GUARANTEE|Not for you? Email us within 30 days. We make it right.' -%}
  <div class="mm-hero__badges-wrap">
    <div class="container-custom">
      <ul class="mm-hero__badges" role="list">
        {%- assign badge_list = '' -%}
        {%- for i in (1..3) -%}
          {%- case i -%}
            {%- when 1 -%}{%- assign b = badge_1 -%}
            {%- when 2 -%}{%- assign b = badge_2 -%}
            {%- when 3 -%}{%- assign b = badge_3 -%}
          {%- endcase -%}
          {%- if b != blank -%}
            {%- assign parts = b | split: '|' -%}
            <li class="mm-hero__badge mm-hero__badge--{{ i }}">
              <span class="mm-hero__badge-head">{{ parts[0] | strip | escape }}</span>
              {%- if parts[1] -%}
                <span class="mm-hero__badge-sub">{{ parts[1] | strip | escape }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<style>
  .mm-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - 80px);
    padding: 108px 0 0;
  }
  .mm-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .mm-hero__eyebrow {
    color: var(--color-primary, #00e5a0);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }
  .mm-hero__h1 {
    color: #fff;
    font-size: clamp(2.5rem, 9vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .mm-hero__hl { color: var(--color-primary, #00e5a0); }
  .mm-hero__lede {
    color: rgba(224, 224, 224, 0.92);
    font-size: clamp(1.0625rem, 2.6vw, 1.25rem);
    line-height: 1.55;
    max-width: 34rem;
    margin: 0 0 32px;
  }
  .mm-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .mm-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 34px;
    border-radius: 999px;
    background: var(--color-primary, #00e5a0);
    color: #0b0b0b;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 0 0 0 rgba(0, 229, 160, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }
  .mm-hero__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px -6px rgba(0, 229, 160, 0.45);
  }
  .mm-hero__cta--gradient {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, #ff4d00, #00e5a0, #009bff, #ff4d00);
    background-size: 300% 100%;
    animation: mm-shimmer 8s linear infinite;
    color: #fff;
    border: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }
  .mm-hero__cta--gradient:hover {
    transform: translateY(-1px) scale(1.03);
    box-shadow: 0 0 15px rgba(0, 229, 160, 0.3), 0 0 32px rgba(255, 77, 0, 0.25);
  }
  .mm-hero__cta-label { position: relative; z-index: 1; }
  @keyframes mm-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .mm-hero__desc {
    color: rgba(224, 224, 224, 0.72);
    font-size: 0.9688rem;
    line-height: 1.65;
    max-width: 32rem;
    margin: 0 0 22px;
  }
  .mm-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 24px;
  }
  .mm-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(224, 224, 224, 0.75);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mm-hero__chip--live {
    border-color: rgba(0, 229, 160, 0.45);
    color: var(--color-primary, #00e5a0);
  }
  .mm-hero__chip--live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary, #00e5a0);
    box-shadow: 0 0 8px rgba(0, 229, 160, 0.9);
  }
  .mm-hero__cta--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: none;
  }
  .mm-hero__cta--ghost:hover {
    border-color: var(--color-primary, #00e5a0);
    color: var(--color-primary, #00e5a0);
    box-shadow: none;
  }
  .mm-hero__cta:focus-visible {
    outline: 2px solid var(--color-primary, #00e5a0);
    outline-offset: 3px;
  }
  .mm-hero__cta-note {
    color: rgba(224, 224, 224, 0.6);
    font-size: 0.8125rem;
    margin: 12px 0 0;
  }
  .mm-hero__media {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .mm-hero__glow {
    position: absolute;
    inset: 10% 6%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 229, 160, 0.16) 0%, rgba(0, 229, 160, 0) 70%);
    filter: blur(24px);
    pointer-events: none;
  }
  .mm-hero__img {
    position: relative;
    width: 100%;
    max-width: 560px;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.8);
  }
  .mm-hero__badges-wrap {
    margin-top: 48px;
    padding: 8px 0 40px;
  }
  .mm-hero__badges {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin: 0;
    padding: 0;
  }
  .mm-hero__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    padding: 16px 26px;
    border-radius: 16px;
    border: 1px solid rgba(0, 229, 160, 0.4);
    background: linear-gradient(180deg, rgba(0, 229, 160, 0.09) 0%, rgba(255, 255, 255, 0.03) 100%);
    box-shadow: 0 8px 30px -12px rgba(0, 229, 160, 0.35);
    max-width: 340px;
  }
  .mm-hero__badge-head {
    color: #fff;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mm-hero__badge-sub {
    color: rgba(224, 224, 224, 0.72);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .mm-hero__badge--1 { transform: rotate(-1.4deg); animation: mm-badge-sway-a 5.4s ease-in-out infinite alternate; }
  .mm-hero__badge--2 { transform: rotate(1deg); animation: mm-badge-sway-b 6.3s ease-in-out infinite alternate; animation-delay: 0.6s; }
  .mm-hero__badge--3 { transform: rotate(-0.7deg); animation: mm-badge-sway-c 7.1s ease-in-out infinite alternate; animation-delay: 1.1s; }
  @keyframes mm-badge-sway-a {
    0% { transform: rotate(-1.4deg) translate(-5px, 0); }
    50% { transform: rotate(-0.4deg) translate(3px, -6px); }
    100% { transform: rotate(-1.6deg) translate(6px, 2px); }
  }
  @keyframes mm-badge-sway-b {
    0% { transform: rotate(1deg) translate(4px, 2px); }
    50% { transform: rotate(0.2deg) translate(-4px, -5px); }
    100% { transform: rotate(1.4deg) translate(-6px, 1px); }
  }
  @keyframes mm-badge-sway-c {
    0% { transform: rotate(-0.7deg) translate(5px, -2px); }
    50% { transform: rotate(0.3deg) translate(-3px, 4px); }
    100% { transform: rotate(-1.1deg) translate(-5px, -4px); }
  }

  @media (min-width: 480px) and (max-width: 1023px) {
    .mm-hero__ctas .mm-hero__cta { flex: 0 1 auto; }
  }
  @media (max-width: 479px) {
    .mm-hero__cta { width: 100%; }
    .mm-hero__badge { width: 100%; max-width: none; }
  }
  @media (min-width: 1024px) {
    .mm-hero { padding-top: 132px; }
    .mm-hero__grid {
      grid-template-columns: 11fr 9fr;
      gap: 56px;
    }
    .mm-hero__badges {
      flex-direction: row;
      justify-content: center;
      align-items: stretch;
      gap: 28px;
    }
    .mm-hero__badge { flex: 1; max-width: 360px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-hero__cta { transition: none; animation: none; }
    .mm-hero__cta:hover { transform: none; }
    .mm-hero__badge--1, .mm-hero__badge--2, .mm-hero__badge--3 { animation: none; }
  }
</style>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Eyebrow",
      "default": "DAILY NOOTROPIC DRINK MIX"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UNLOCK YOUR MENTAL EDGE"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted phrase (must appear in heading)",
      "default": "MENTAL EDGE"
    },
    {
      "type": "text",
      "id": "lede_text",
      "label": "Lede",
      "default": "Clinically-dosed nootropics for a sharper, faster mind. Work smarter."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Get MindMix"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "CTA note (small text under buttons)",
      "default": "Get your MindMix today for as low as $69.95."
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Description paragraph (empty = hidden)"
    },
    {
      "type": "text",
      "id": "chip_1",
      "label": "Availability chip 1 (mint dot)",
      "default": "Green Apple Kiwi, in stock now"
    },
    {
      "type": "text",
      "id": "chip_2",
      "label": "Availability chip 2",
      "default": "2 new flavors coming soon"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA text (hidden if empty)"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "header",
      "content": "Proof badges: HEADLINE|support line"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge 1",
      "default": "FULL DOSES. ZERO HIDING.|Every dose printed on the label"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge 2",
      "default": "THIRD-PARTY TESTED|Certificate of analysis available"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Badge 3",
      "default": "30-DAY GUARANTEE|Not for you? Email us within 30 days. We make it right."
    }
  ]
}
{% endschema %}
