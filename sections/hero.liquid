{% comment %}
  MindMix hero (upgraded 2026-07)
  - In-flow CTA row (the old absolutely-positioned try-it-free-btn rendered clipped
    off-screen on mobile and was the only CTA; removed)
  - Three text levels: eyebrow / H1 with highlight phrase / lede
  - "Label facts" row instead of icon benefit cards
  - Scoped CSS: style.css is compiled Tailwind, new utility classes will not exist
{% endcomment %}

{%- assign hl = section.settings.heading_highlight | strip -%}
{%- assign heading_html = section.settings.heading | escape -%}
{%- if hl != blank -%}
  {%- assign hl_esc = hl | escape -%}
  {%- capture hl_span -%}<span class="mm-hero__hl">{{ hl_esc }}</span>{%- endcapture -%}
  {%- assign heading_html = heading_html | replace: hl_esc, hl_span -%}
{%- endif -%}

<section class="mm-hero neural-bg" id="mm-hero">
  <div class="container-custom">
    <div class="mm-hero__grid">
      <div class="mm-hero__copy fade-in">
        {%- if section.settings.tagline != blank -%}
          <p class="mm-hero__eyebrow">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}

        <h1 class="mm-hero__h1">{{ heading_html }}</h1>

        {%- if section.settings.subheading != blank -%}
          <p class="mm-hero__lede">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        <div class="mm-hero__ctas">
          <a class="mm-hero__cta" href="{{ section.settings.cta_url | default: '/products/green-apple-kiwi' }}">
            {{ section.settings.cta_text | default: 'Get MindMix' | escape }}
          </a>
          {%- if section.settings.secondary_cta_text != blank and section.settings.secondary_cta_url != blank -%}
            <a class="mm-hero__cta mm-hero__cta--ghost" href="{{ section.settings.secondary_cta_url }}">
              {{ section.settings.secondary_cta_text | escape }}
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_note != blank -%}
          <p class="mm-hero__cta-note">{{ section.settings.cta_note | escape }}</p>
        {%- endif -%}
      </div>

      <div class="mm-hero__media fade-in">
        <div class="mm-hero__glow" aria-hidden="true"></div>
        {%- assign hero = section.settings.hero_image -%}
        {%- if hero != blank -%}
          <img
            class="mm-hero__img"
            alt="{{ hero.alt | default: 'MindMix nootropic drink mix' | escape }}"
            width="{{ hero.width }}"
            height="{{ hero.height }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            src="{{ hero | image_url: width: 900 }}"
            srcset="
              {{ hero | image_url: width: 480 }} 480w,
              {{ hero | image_url: width: 640 }} 640w,
              {{ hero | image_url: width: 900 }} 900w,
              {{ hero | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 1024px) 48vw, 92vw"
          >
        {%- else -%}
          <img
            class="mm-hero__img"
            alt="MindMix Green Apple Kiwi stick pack"
            loading="eager"
            decoding="async"
            src="{{ 'mindmix_green_apple_kiwi.png' | asset_url }}"
          >
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Label facts row: short verifiable statements, styled like label fine print {%- endcomment -%}
  {%- assign has_facts = false -%}
  {%- if section.settings.fact_1 != blank or section.settings.fact_2 != blank or section.settings.fact_3 != blank -%}
    {%- assign has_facts = true -%}
  {%- endif -%}
  {%- if has_facts -%}
    <div class="mm-hero__facts-wrap">
      <div class="container-custom">
        <ul class="mm-hero__facts" role="list">
          {%- if section.settings.fact_1 != blank -%}
            <li class="mm-hero__fact">{{ section.settings.fact_1 | escape }}</li>
          {%- endif -%}
          {%- if section.settings.fact_2 != blank -%}
            <li class="mm-hero__fact">{{ section.settings.fact_2 | escape }}</li>
          {%- endif -%}
          {%- if section.settings.fact_3 != blank -%}
            <li class="mm-hero__fact">{{ section.settings.fact_3 | escape }}</li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  .mm-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - 80px);
    padding: 108px 0 0;
  }
  .mm-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .mm-hero__eyebrow {
    color: var(--color-primary, #00e5a0);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }
  .mm-hero__h1 {
    color: #fff;
    font-size: clamp(2.5rem, 9vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .mm-hero__hl { color: var(--color-primary, #00e5a0); }
  .mm-hero__lede {
    color: rgba(224, 224, 224, 0.92);
    font-size: clamp(1.0625rem, 2.6vw, 1.25rem);
    line-height: 1.55;
    max-width: 34rem;
    margin: 0 0 32px;
  }
  .mm-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .mm-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 34px;
    border-radius: 999px;
    background: var(--color-primary, #00e5a0);
    color: #0b0b0b;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 0 0 0 rgba(0, 229, 160, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }
  .mm-hero__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px -6px rgba(0, 229, 160, 0.45);
  }
  .mm-hero__cta--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: none;
  }
  .mm-hero__cta--ghost:hover {
    border-color: var(--color-primary, #00e5a0);
    color: var(--color-primary, #00e5a0);
    box-shadow: none;
  }
  .mm-hero__cta:focus-visible {
    outline: 2px solid var(--color-primary, #00e5a0);
    outline-offset: 3px;
  }
  .mm-hero__cta-note {
    color: rgba(224, 224, 224, 0.6);
    font-size: 0.8125rem;
    margin: 12px 0 0;
  }
  .mm-hero__media {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .mm-hero__glow {
    position: absolute;
    inset: 10% 6%;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 229, 160, 0.16) 0%, rgba(0, 229, 160, 0) 70%);
    filter: blur(24px);
    pointer-events: none;
  }
  .mm-hero__img {
    position: relative;
    width: 100%;
    max-width: 560px;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.8);
  }
  .mm-hero__facts-wrap {
    margin-top: 56px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }
  .mm-hero__facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
  }
  .mm-hero__fact {
    color: rgba(224, 224, 224, 0.82);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    padding: 14px 0;
    text-align: center;
  }
  .mm-hero__fact + .mm-hero__fact {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  @media (min-width: 480px) and (max-width: 1023px) {
    .mm-hero__ctas .mm-hero__cta { flex: 0 1 auto; }
  }
  @media (max-width: 479px) {
    .mm-hero__cta { width: 100%; }
  }
  @media (min-width: 1024px) {
    .mm-hero { padding-top: 132px; }
    .mm-hero__grid {
      grid-template-columns: 11fr 9fr;
      gap: 56px;
    }
    .mm-hero__facts {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .mm-hero__fact {
      flex: 1;
      padding: 18px 24px;
      text-align: center;
    }
    .mm-hero__fact + .mm-hero__fact {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.07);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-hero__cta { transition: none; }
    .mm-hero__cta:hover { transform: none; }
  }
</style>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Eyebrow",
      "default": "DAILY NOOTROPIC DRINK MIX"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UNLOCK YOUR MENTAL EDGE"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted phrase (must appear in heading)",
      "default": "MENTAL EDGE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Lede",
      "default": "A daily nootropic drink mix. Full doses, printed on the label."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Get MindMix"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "CTA note (small text under buttons)"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA text (hidden if empty)"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "header",
      "content": "Label facts row (short, verifiable, claims-safe)"
    },
    {
      "type": "text",
      "id": "fact_1",
      "label": "Fact 1",
      "default": "Full doses, printed on the label"
    },
    {
      "type": "text",
      "id": "fact_2",
      "label": "Fact 2",
      "default": "Third-party tested"
    },
    {
      "type": "text",
      "id": "fact_3",
      "label": "Fact 3",
      "default": "Caffeine from green tea, not espresso"
    }
  ]
}
{% endschema %}
